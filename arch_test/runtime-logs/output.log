# Function to archive, encrypt, and split
archive_encrypt_split() {
    SRC_PATH=$1
    ARCHIVE_NAME=$2

    echo "Processing: $SRC_PATH -> $ARCHIVE_NAME"

    tar -czf - "$SRC_PATH" | \
        gpg --batch --yes --symmetric --cipher-algo AES256 --passphrase "$ARCHIVE_PWD" | \
